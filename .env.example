# Formuläret ger 503 tills alla mejlinställningar är konfigurerade.
# Använd en mottagare företaget har bekräftat och en verifierad avsändardomän.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Sätt true först på färdig, publik produktion. Förhandsversionen är noindex.
SITE_INDEXABLE=false
# Valfri separat byggmapp, t.ex. .next-dev vid utveckling parallellt med build.
# NEXT_DIST_DIR=.next-dev

